generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                     String         @id @default(cuid())
  slug                   String         @unique
  name                   String
  brandColor             String         @default("#E84040")
  secondaryColor         String         @default("#2D2D2D")
  logoUrl                String?
  vatRate                Float          @default(18)
  vatMode                String         @default("inclusive")
  currency               String         @default("TRY")
  receiptPrefix          String         @default("")
  defaultLang            String         @default("tr")
  soundNotif             Boolean        @default(true)
  visualNotif            Boolean        @default(true)
  orderApprovalRequired  Boolean        @default(false)
  createdAt              DateTime       @default(now())

  users          User[]
  tables         Table[]
  sessions       TableSession[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  orders         Order[]
  payments       Payment[]
}

enum UserRole {
  ADMIN
  CASHIER
  WAITER
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  username     String
  passwordHash String
  role         UserRole @default(WAITER)
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, username])
  @@index([tenantId])
}

enum TableStatus {
  EMPTY
  OPEN
  CLOSED
}

model Table {
  id       String      @id @default(cuid())
  tenantId String
  number   Int
  label    String?
  capacity Int         @default(4)
  status   TableStatus @default(EMPTY)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions TableSession[]

  @@unique([tenantId, number])
  @@index([tenantId])
}

enum SessionStatus {
  ACTIVE
  CLOSED
}

model TableSession {
  id         String        @id @default(cuid())
  tableId    String
  tenantId   String
  pin        String
  guestCount Int           @default(1)
  openedAt   DateTime      @default(now())
  closedAt   DateTime?
  status     SessionStatus @default(ACTIVE)

  table    Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders   Order[]
  payments Payment[]

  @@index([tenantId])
  @@index([tableId, status])
}

model MenuCategory {
  id        String @id @default(cuid())
  tenantId  String
  name      String
  sortOrder Int    @default(0)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  MenuItem[]

  @@index([tenantId])
}

model MenuItem {
  id          String  @id @default(cuid())
  tenantId    String
  categoryId  String
  name        String
  description String?
  price       Float
  available   Boolean @default(true)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([categoryId])
}

enum OrderStatus {
  PENDING_APPROVAL
  APPROVED
  PREPARING
  SERVED
  CANCELLED
}

enum OrderSource {
  CUSTOMER
  KIOSK
}

model Order {
  id        String      @id @default(cuid())
  sessionId String
  tenantId  String
  status    OrderStatus @default(PENDING_APPROVAL)
  source    OrderSource @default(CUSTOMER)
  createdAt DateTime    @default(now())

  session TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items   OrderItem[]

  @@index([tenantId])
  @@index([sessionId])
  @@index([status])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  menuItemId String
  name       String
  price      Float
  quantity   Int     @default(1)
  note       String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum PaymentMethod {
  CASH
  CARD
  SPLIT
}

model Payment {
  id        String        @id @default(cuid())
  sessionId String
  tenantId  String
  amount    Float
  method    PaymentMethod @default(CASH)
  paidAt    DateTime      @default(now())

  session TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sessionId])
}
